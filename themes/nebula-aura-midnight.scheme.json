{
  "name": "Nebula Aura Midnight",
  "tokens": {
    // Syntax
    "--syn-keyword": "#cbd6f5",
    "--syn-string": "#a7d9c5",
    "--syn-type": "#d1dcec",
    "--syn-function": "#afdff4",
    "--syn-function-call": "#dce3ef",
    "--syn-comment": "#9aa4b5",
    "--syn-comment-style": "normal",
    "--syn-doc-comment": "#acb5c5",
    "--syn-docstring": "#a7d9c5",
    "--syn-annotation": "#a2dbc4",
    "--syn-decorator": "#a2dbc4",
    "--syn-number": "#eece9a",
    "--syn-punct": "#c7ceda",
    "--syn-variable": "#dce3ef",
    "--syn-global": "var(--syn-variable)",
    "--syn-param": "#eece9a",
    "--syn-property": "#dce3ef",
    "--syn-constant": "#d5dbf6",
    // Python and PHP name their variables and calls on their own
    "--syn-python-local-variable": "var(--syn-variable)",
    "--syn-python-global-variable": "var(--syn-global)",
    "--syn-python-instance-attribute": "var(--syn-variable)",
    "--syn-python-class-attribute": "var(--syn-property)",
    "--syn-python-constant": "var(--syn-constant)",
    "--syn-python-property": "var(--syn-property)",
    "--syn-python-type-parameter": "var(--syn-type)",
    "--syn-python-builtin": "var(--syn-builtin)",
    "--syn-python-predefined-definition": "var(--syn-predefined)",
    "--syn-python-predefined-usage": "var(--syn-predefined)",
    "--syn-python-fstring": "#c8e6d8",
    "--syn-python-bytes": "#c8e6d8",
    "--syn-php-variable": "var(--syn-property)",
    "--syn-php-function-call": "var(--syn-function)",
    "--syn-builtin": "#d1dcec",
    "--syn-self": "#d5dbf6",
    "--syn-keyword-arg": "#eece9a",
    "--syn-predefined": "#d5dbf6",
    "--syn-escape": "#ebe3a8",
    "--syn-regexp": "#a7d9c5",
    "--syn-tag": "#d1dcec",
    "--syn-attribute": "#a2dbc4",
    "--syn-todo": "#eece9a",
    "--syn-link": "#afdff4",
    "--syn-markup-heading": "#d5dbf6",
    "--syn-markup-code": "#a2dbc4",
    "--syn-invalid": "#efa0aa",
    "--syn-inline-value": "#dce3eeb3",
    "--syn-rainbow-1": "#afdff4",
    "--syn-rainbow-2": "#eece9a",
    "--syn-rainbow-3": "#d5dbf6",
    "--syn-rainbow-4": "#a2dbc4",
    "--syn-rainbow-5": "#d1dcec",
    "--syn-bracket-1": "#ebe3a8",
    "--syn-bracket-2": "#afdff4",
    "--syn-bracket-3": "#a2dbc4",

    // Editor
    "--fg-editor": "#dce3ee",
    "--caret": "#7ec8e8",
    "--fg-line-number": "#8996aa",
    "--fg-line-number-current": "#8fc9e8",
    "--border-gutter": "#101520",
    "--border-indent-guide": "#1d2431",
    "--border-indent-guide-active": "#333d4d",
    "--border-right-margin": "#1d2431",
    "--bg-editor-selection": "#213547",
    "--bg-editor-selection-inactive": "#1a2937",
    "--bg-text-search-result": "#284449",
    "--bg-text-search-result-current": "#3a565c",
    "--bg-matched-brace": "#2c3e52",
    "--matched-brace-weight": "700",
    "--bg-matched-tag": "#7ec8e833",
    "--bg-fold-placeholder": "#161e2a",
    "--fg-fold-placeholder": "#8996aa",
    "--fg-fold-marker": "#7b8998",
    "--fg-whitespace": "#dce3ee1a",
    "--fg-unused": "#dce3ee73",
    "--bg-identifier-under-caret": "#7ec8e833",
    "--bg-identifier-under-caret-write": "#79c7a838",
    "--fg-inlay": "#8996aa",
    "--bg-inlay": "#101520",
    "--wave-error": "#e2707f",
    "--wave-warning": "#d9a45e",
    "--editor-error-decoration": "underline wavy #e2707f",
    "--editor-warning-decoration": "underline wavy #d9a45e",
    "--editor-warning-background": "transparent",
    "--bg-breakpoint-line": "#2d1e28",
    "--fg-completion-match": "#8fc9e8",
    "--bg-editor-inline": "#101520",
    "--bg-editor-banner": "#1a2834",
    "--fg-weak-warning": "#6c798d",
    "--fg-bulb": "#dcd07a",

    // ANSI palette
    "--ansi-black": "#070a11",
    "--ansi-red": "#e2707f",
    "--ansi-green": "#79c7a8",
    "--ansi-yellow": "#dcd07a",
    "--ansi-blue": "#7ec8e8",
    "--ansi-magenta": "#a8b3e8",
    "--ansi-cyan": "#79d0cf",
    "--ansi-white": "#d3dae4",
    "--ansi-bright-black": "#6c798d",
    "--ansi-bright-red": "#ef8b98",
    "--ansi-bright-green": "#90d9bc",
    "--ansi-bright-yellow": "#e8d488",
    "--ansi-bright-blue": "#9bd6ef",
    "--ansi-bright-magenta": "#c0b8f0",
    "--ansi-bright-cyan": "#97dcd8",
    "--ansi-bright-white": "#dce1e9",

    // Terminal ANSI palette
    "--terminal-ansi-black": "#070a11",
    "--terminal-ansi-red": "#e2707f",
    "--terminal-ansi-green": "#79c7a8",
    "--terminal-ansi-yellow": "#dcd07a",
    "--terminal-ansi-blue": "#7ec8e8",
    "--terminal-ansi-magenta": "#a8b3e8",
    "--terminal-ansi-cyan": "#79d0cf",
    "--terminal-ansi-white": "#d3dae4",
    "--terminal-ansi-bright-black": "#6c798d",
    "--terminal-ansi-bright-red": "#ef8b98",
    "--terminal-ansi-bright-green": "#90d9bc",
    "--terminal-ansi-bright-yellow": "#e8d488",
    "--terminal-ansi-bright-blue": "#9bd6ef",
    "--terminal-ansi-bright-magenta": "#c0b8f0",
    "--terminal-ansi-bright-cyan": "#97dcd8",
    "--terminal-ansi-bright-white": "#dce1e9"
  }
}
