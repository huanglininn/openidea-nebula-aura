    "--border-popup": "#2e2b36",
    "--border-strong": "#3b3746",
    "--border-window": "#3b3746",
    "--control-off": "#7f7a90",

    // Text
    "--fg-strong": "#eae8f1",
    "--fg-emphasis": "#d9d7e2",
    "--fg": "#d9d7e2",
    "--fg-secondary": "#a7a2b6",
    "--fg-muted": "#9a95aa",
