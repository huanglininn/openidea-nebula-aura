  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#17151e",
    "--bg-elev": "#1d1a25",
    "--bg-popup": "#23202b",
    "--bg-floating-toolbar": "#23202b",
    "--bg-hover": "#2a2734",
    "--bg-selected": "#322d45",
