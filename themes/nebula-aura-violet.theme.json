    "--accent": "#b58ad8",
    "--link": "#79b8d8",
    "--link-hover": "#a4d4e8",

    // Charts
    "--chart-series": "#d9a45e",

    // Status
    "--danger": "#e07085",
    "--warning": "#d9a45e",
    "--success": "#79c795",
    "--db-connected": "#6fd68c",
