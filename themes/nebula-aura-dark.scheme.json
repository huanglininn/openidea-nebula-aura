{
  "name": "Nebula Aura Dark",
  "tokens": {
    // Syntax
    "--syn-keyword": "#e3b4d0",
    "--syn-string": "#c5dba7",
    "--syn-type": "#cbd8ee",
    "--syn-function": "#b0d4f4",
    "--syn-function-call": "#e1e3ea",
    "--syn-comment": "#a3a8b6",
    "--syn-comment-style": "normal",
    "--syn-doc-comment": "#abb0be",
    "--syn-docstring": "#c5dba7",
    "--syn-annotation": "#a2dbb7",
    "--syn-decorator": "#a2dbb7",
    "--syn-number": "#e8c08c",
    "--syn-punct": "#c4c8d3",
    "--syn-variable": "#e1e3ea",
    "--syn-global": "var(--syn-variable)",
    "--syn-param": "#e8c08c",
    "--syn-property": "#e1e3ea",
    "--syn-constant": "#d3d7f1",
    // Python and PHP name their variables and calls on their own
    "--syn-python-local-variable": "var(--syn-variable)",
    "--syn-python-global-variable": "var(--syn-global)",
    "--syn-python-instance-attribute": "var(--syn-variable)",
    "--syn-python-class-attribute": "var(--syn-property)",
    "--syn-python-constant": "var(--syn-constant)",
    "--syn-python-property": "var(--syn-property)",
    "--syn-python-type-parameter": "var(--syn-type)",
    "--syn-python-builtin": "var(--syn-builtin)",
    "--syn-python-predefined-definition": "var(--syn-predefined)",
    "--syn-python-predefined-usage": "var(--syn-predefined)",
    "--syn-python-fstring": "#e1eab8",
    "--syn-python-bytes": "#e1eab8",
    "--syn-php-variable": "var(--syn-property)",
    "--syn-php-function-call": "var(--syn-function)",
    "--syn-builtin": "#cbd8ee",
    "--syn-self": "#d3d7f1",
    "--syn-keyword-arg": "#e8c08c",
    "--syn-predefined": "#d3d7f1",
    "--syn-escape": "#e8d698",
    "--syn-regexp": "#c5dba7",
    "--syn-tag": "#cbd8ee",
    "--syn-attribute": "#a2dbb7",
    "--syn-todo": "#e8c08c",
    "--syn-link": "#9cc6e8",
    "--syn-markup-heading": "#d3d7f1",
    "--syn-markup-code": "#a2dbb7",
    "--syn-invalid": "#ee9fab",
    "--syn-inline-value": "#d3d6dfb3",
    "--syn-rainbow-1": "#9cc6e8",
    "--syn-rainbow-2": "#e8c08c",
    "--syn-rainbow-3": "#d3d7f1",
    "--syn-rainbow-4": "#a2dbb7",
    "--syn-rainbow-5": "#cbd8ee",
    "--syn-bracket-1": "#e8d698",
    "--syn-bracket-2": "#9cc6e8",
    "--syn-bracket-3": "#a2dbb7",

    // Editor
    "--fg-editor": "#d3d6df",
    "--caret": "#6fa9d8",
    "--fg-line-number": "#8a90a2",
    "--fg-line-number-current": "#8fc0ea",
    "--border-gutter": "#1b1d24",
    "--border-indent-guide": "#23252d",
    "--border-indent-guide-active": "#383c47",
    "--border-right-margin": "#23252d",
    "--bg-editor-selection": "#2c3546",
    "--bg-editor-selection-inactive": "#242b38",
    "--bg-text-search-result": "#144b56",
    "--bg-text-search-result-current": "#215e6a",
    "--bg-matched-brace": "#39445a",
    "--matched-brace-weight": "700",
    "--bg-matched-tag": "#6fa9d833",
    "--bg-fold-placeholder": "#22252d",
    "--fg-fold-placeholder": "#8a90a2",
    "--fg-fold-marker": "#7a8091",
    "--fg-whitespace": "#d3d6df1a",
    "--fg-unused": "#d3d6df73",
    "--bg-identifier-under-caret": "#6fa9d833",
    "--bg-identifier-under-caret-write": "#79c79538",
    "--fg-inlay": "#8a90a2",
    "--bg-inlay": "#1b1d24",
    "--wave-error": "#e07080",
    "--wave-warning": "#d9a45e",
    "--editor-error-decoration": "underline wavy #e07080",
    "--editor-warning-decoration": "underline wavy #d9a45e",
    "--editor-warning-background": "transparent",
    "--bg-breakpoint-line": "#36252c",
    "--fg-completion-match": "#8fc0ea",
    "--bg-editor-inline": "#1b1d24",
    "--bg-editor-banner": "#222b36",
    "--fg-weak-warning": "#6c7281",
    "--fg-bulb": "#d9c06a",

    // ANSI palette
    "--ansi-black": "#101116",
    "--ansi-red": "#e07080",
    "--ansi-green": "#79c795",
    "--ansi-yellow": "#d9c06a",
    "--ansi-blue": "#6fa9d8",
    "--ansi-magenta": "#a7aee0",
    "--ansi-cyan": "#7ec9c4",
    "--ansi-white": "#d3d6df",
    "--ansi-bright-black": "#6c7281",
    "--ansi-bright-red": "#ef8a98",
    "--ansi-bright-green": "#90d9a8",
    "--ansi-bright-yellow": "#e8d488",
    "--ansi-bright-blue": "#8dc0ea",
    "--ansi-bright-magenta": "#bcbff0",
    "--ansi-bright-cyan": "#97dcd8",
    "--ansi-bright-white": "#e5e7ed",

    // Terminal ANSI palette
    "--terminal-ansi-black": "#101116",
    "--terminal-ansi-red": "#e07080",
    "--terminal-ansi-green": "#79c795",
    "--terminal-ansi-yellow": "#d9c06a",
    "--terminal-ansi-blue": "#6fa9d8",
    "--terminal-ansi-magenta": "#a7aee0",
    "--terminal-ansi-cyan": "#7ec9c4",
    "--terminal-ansi-white": "#d3d6df",
    "--terminal-ansi-bright-black": "#6c7281",
    "--terminal-ansi-bright-red": "#ef8a98",
    "--terminal-ansi-bright-green": "#90d9a8",
    "--terminal-ansi-bright-yellow": "#e8d488",
    "--terminal-ansi-bright-blue": "#8dc0ea",
    "--terminal-ansi-bright-magenta": "#bcbff0",
    "--terminal-ansi-bright-cyan": "#97dcd8",
    "--terminal-ansi-bright-white": "#e5e7ed"
  }
}
