    "--bg-matched-brace": "#3d3850",
    "--matched-brace-weight": "700",
    "--bg-matched-tag": "#79b8d833",
    "--bg-fold-placeholder": "#24212c",
    "--fg-fold-placeholder": "#8e899f",
    "--fg-fold-marker": "#7f7a90",
    "--fg-whitespace": "#d9d7e21a",
    "--fg-unused": "#d9d7e273",
    "--bg-identifier-under-caret": "#79b8d833",
    "--bg-identifier-under-caret-write": "#79c79538",
    "--fg-inlay": "#8e899f",
