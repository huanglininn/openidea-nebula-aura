{
  "name": "Nebula Aura Violet",
  "tokens": {
    // Syntax
    "--syn-keyword": "#e3cbf5",
    "--syn-string": "#c8deb2",
    "--syn-type": "#cdd5eb",
    "--syn-function": "#b7ccf4",
    "--syn-function-call": "#e3e1ea",
    "--syn-comment": "#a6a6b6",
    "--syn-comment-style": "normal",
    "--syn-doc-comment": "#aeaabb",
    "--syn-docstring": "#c8deb2",
    "--syn-annotation": "#a2dbb7",
    "--syn-decorator": "#a2dbb7",
    "--syn-number": "#e8c294",
    "--syn-punct": "#c7c4d1",
    "--syn-variable": "#e3e1ea",
    "--syn-global": "var(--syn-variable)",
    "--syn-param": "#e8c294",
    "--syn-property": "#e3e1ea",
    "--syn-constant": "#d6d3f6",
    // Python and PHP name their variables and calls on their own
    "--syn-python-local-variable": "var(--syn-variable)",
    "--syn-python-global-variable": "var(--syn-global)",
    "--syn-python-instance-attribute": "var(--syn-variable)",
    "--syn-python-class-attribute": "var(--syn-property)",
    "--syn-python-constant": "var(--syn-constant)",
    "--syn-python-property": "var(--syn-property)",
    "--syn-python-type-parameter": "var(--syn-type)",
    "--syn-python-builtin": "var(--syn-builtin)",
    "--syn-python-predefined-definition": "var(--syn-predefined)",
    "--syn-python-predefined-usage": "var(--syn-predefined)",
    "--syn-python-fstring": "#e5eac4",
    "--syn-python-bytes": "#e5eac4",
    "--syn-php-variable": "var(--syn-property)",
    "--syn-php-function-call": "var(--syn-function)",
    "--syn-builtin": "#cdd5eb",
    "--syn-self": "#d6d3f6",
    "--syn-keyword-arg": "#e8c294",
    "--syn-predefined": "#d6d3f6",
    "--syn-escape": "#e9daa7",
    "--syn-regexp": "#c8deb2",
    "--syn-tag": "#cdd5eb",
    "--syn-attribute": "#a2dbb7",
    "--syn-todo": "#e8c294",
    "--syn-link": "#a6d2e8",
    "--syn-markup-heading": "#d6d3f6",
    "--syn-markup-code": "#a2dbb7",
    "--syn-invalid": "#ee9fae",
    "--syn-inline-value": "#d9d7e2b3",
    "--syn-rainbow-1": "#a6d2e8",
    "--syn-rainbow-2": "#e8c294",
    "--syn-rainbow-3": "#d6d3f6",
    "--syn-rainbow-4": "#a2dbb7",
    "--syn-rainbow-5": "#cdd5eb",
    "--syn-bracket-1": "#e9daa7",
    "--syn-bracket-2": "#a6d2e8",
    "--syn-bracket-3": "#a2dbb7",

    // Editor
    "--fg-editor": "#d9d7e2",
    "--caret": "#79b8d8",
    "--fg-line-number": "#8e899f",
    "--fg-line-number-current": "#96c4e0",
    "--border-gutter": "#1d1a25",
