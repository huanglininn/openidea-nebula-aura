    "--editor-error-decoration": "underline wavy #e07085",
    "--editor-warning-decoration": "underline wavy #d9a45e",
    "--editor-warning-background": "transparent",
    "--bg-breakpoint-line": "#37242e",
    "--fg-completion-match": "#96c4e0",
