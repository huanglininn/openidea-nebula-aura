    "--terminal-ansi-bright-red": "#ef8a98",
    "--terminal-ansi-bright-green": "#90d9a8",
    "--terminal-ansi-bright-yellow": "#e8d488",
    "--terminal-ansi-bright-blue": "#95c4e0",
    "--terminal-ansi-bright-magenta": "#c0b4f0",
    "--terminal-ansi-bright-cyan": "#97dcd8",
