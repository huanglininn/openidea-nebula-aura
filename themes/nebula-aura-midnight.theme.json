    "--diff-modified": "#3d5e78",
    "--diff-inserted": "#345955",
    "--diff-deleted": "#653a4a",
    "--diff-modified-stripe": "#3f6680",
    "--diff-inserted-stripe": "#3e6660",
    "--diff-deleted-stripe": "#7f5262",
    "--diff-conflict-stripe": "#7f544d",

    // Shadows and window controls
    "--shadow-popup": "0 6px 20px rgba(0, 0, 0, 0.45)",
    "--shadow-dialog": "0 0 0 0.5px rgba(0, 0, 0, 0.6), 0 10px 24px rgba(0, 0, 0, 0.35), 0 24px 72px rgba(0, 0, 0, 0.45)",
    "--traffic-close": "#ff5f57",
    "--traffic-close-border": "#e0443e",
    "--traffic-close-pressed": "#bf4942",
    "--traffic-glyph": "#4d0000",
    "--traffic-off": "#222a37",
    "--traffic-off-border": "#1c2330",

    // Additive
    "--bg-tooltip": "#151b27",
    "--fg-tooltip": "#dce3ee",
    "--border-tooltip": "#252e3c",
    "--bg-control": "#101520",
    "--bg-control-hover": "#192230",
    "--bg-active": "#2c3e52",
    "--bg-scrim": "rgba(0, 0, 0, 0.52)",
    "--fg-on-accent": "#0a0e17",
    "--shadow-tooltip": "0 4px 12px rgba(0, 0, 0, 0.40)",
    "--shadow-balloon": "0 8px 24px rgba(0, 0, 0, 0.45)",

    // Islands contract
    "--bg-frame": "#070a11",
    "--bg-island": "#0a0e17",
    "--bg-stripe-hover": "#dce3ee17",
    "--bg-stripe-selected": "#dce3ee29",
    "--fg-stripe-selected-active": "#0a0e17",
    "--fg-stripe-label": "#a3afc0",
    "--bg-tab-selected": "#101826",
    "--border-tab-selected": "#3d4653",
    "--bg-tab-selected-inactive": "#070a11",
    "--border-tab-selected-inactive": "#333d4d",
    "--bg-tab-hover": "#192230",
    "--border-editor-tabs": "#101520",
    "--bg-tree-selected": "#203041",
    "--bg-tree-selected-inactive": "#152130",
    "--bg-tree-hover": "#192230",
    "--bg-toolbar-hover": "#192230",
    "--bg-toolbar-pressed": "#203041",
    "--bg-toolbar-selected": "#203041",
    "--bg-toolbar-selected-hover": "#2c3e52",
    "--bg-button-primary-hover": "#a4b9ee",
    "--fg-button-primary": "#0a0e17",
    "--bg-button": "#101520",
    "--border-button": "#252e3c",
    "--bg-field": "#0a0e17",
    "--bg-checkbox": "#0a0e17",
    "--border-checkbox": "#333d4d",
    "--bg-toggle-on": "#4fae8a",
    "--fg-toggle-on": "#070a11",
    "--bg-toggle-off": "#101520",
    "--fg-toggle-off": "#8895a8",
    "--border-toggle": "#333d4d",
    "--bg-toggle-knob": "#7b8998",
    "--focus-ring-soft": "#414a59",
    "--scrollbar-thumb": "#8996aa5c",
    "--scrollbar-thumb-hover": "#8996aa94",
    "--bg-search-match": "#4e3d21",
    "--bg-search-match-current": "#644e2a",
    "--fg-search-match": "#dce1e9",
    "--bg-dialog": "#101520",
    "--bg-popup-inline": "#101520",
