    "--bg-feedback-warning": "#2c2929",
    "--border-feedback-warning": "#6a553c",
    "--bg-feedback-success": "#1f2e33",
    "--border-feedback-success": "#3a5c56",
    "--bg-counter": "#203041",
    "--fg-counter": "#dce3ee",
    "--bg-progress-track": "#232b38"
