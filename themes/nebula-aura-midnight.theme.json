{
  "id": "nebula-aura-midnight",
  "name": "Nebula Aura Midnight",
  "kind": "dark",
  "tokens": {
    // Surfaces
    "--bg-app": "#0a0e17",
    "--bg-elev": "#101520",
    "--bg-popup": "#151b27",
    "--bg-floating-toolbar": "#151b27",
    "--bg-hover": "#192230",
    "--bg-selected": "#203041",
    "--bg-selected-strong": "#2c3e52",
    "--bg-current-line": "#101b27",
    "--bg-debug-line": "#1d2c38",
    "--bg-backdrop": "#101520",
    "--bg-input": "#0a0e17",

    // Lines
    "--border": "#1d2431",
    "--border-popup": "#252e3c",
    "--border-strong": "#333d4d",
    "--border-window": "#333d4d",
    "--control-off": "#7b8998",

    // Text
    "--fg-strong": "#dce1e9",
    "--fg-emphasis": "#dce3ee",
    "--fg": "#dce3ee",
    "--fg-secondary": "#a3afc0",
    "--fg-muted": "#97a3b5",
    "--fg-subtle": "#8895a8",
    "--fg-faint": "#6c798d",
    "--fg-gutter": "#8996aa",
    "--fg-icon": "#d3dbe6",

    // Accent
    "--accent": "#8fa8e8",
    "--link": "#7ec8e8",
    "--link-hover": "#a8dcef",

    // Charts
    "--chart-series": "#d9a45e",

    // Status
    "--danger": "#e2707f",
    "--warning": "#d9a45e",
    "--success": "#79c7a8",
    "--db-connected": "#6fd6a8",
    "--db-connected-ring": "#2e7a5c",
    "--info": "#7ec8e8",

    // Vcs
    "--vcs-modified": "#7ec8e8",
    "--vcs-added": "#79c7a8",
    "--vcs-deleted": "#c46a78",
    "--vcs-untracked": "#79c7a8",
    "--vcs-ignored": "#97a3b5",
    "--vcs-conflict": "#d9a45e",
    "--gutter-modified": "#5f9fbf",
    "--gutter-added": "#5d9e82",
    "--gutter-deleted": "#a35a66",
